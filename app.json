{
  "expo": {
    "name": "Volt",
    "slug": "volt",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "volt",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "dev.nordrift.volt",
      "versionCode": 1,
      "permissions": [],
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E1216",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_icon_cream.png",
          "backgroundColor": "#3C3A63",
          "dark": {
            "image": "./assets/images/splash_icon_frost.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
